<Project>
  <PropertyGroup>
    <!-- The only product-version source used by builds, packages, and CI. -->
    <VersionPrefix>1.1.0</VersionPrefix>
    <Version>$(VersionPrefix)</Version>
    <AssemblyVersion>$(VersionPrefix).0</AssemblyVersion>
    <FileVersion>$(VersionPrefix).0</FileVersion>
    <InformationalVersion>$(VersionPrefix)</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <Company>LoL Performance Overlay contributors</Company>
    <Product>LoL 即時表現 Overlay</Product>
    <Copyright>Copyright (c) LoL Performance Overlay contributors</Copyright>
  </PropertyGroup>
</Project>
